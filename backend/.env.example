# Application Environment
APP_ENV=development
API_V1_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Database Configuration (SQLite default for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./insightflow.db

# CORS Allowed Origins
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Upload & Rate Limits
MAX_UPLOAD_MB=25
MAX_CSV_ROWS=50000

# AI Provider Configuration
# Options: template (default, deterministic fallback), openai, anthropic
AI_PROVIDER=template
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Adaption Labs Integration
# Official SDK: pip install adaption (auth via ADAPTION_API_KEY)
ADAPTION_ENABLED=false
ADAPTION_API_KEY=
